# API listen settings
HOST=0.0.0.0
PORT=8080

# Optional: absolute path for SQLite file (recommended on cloud with mounted disk)
# DB_PATH=/data/inventory.db

# Optional: override initial JSON seed file paths
# MASTER_DATA_PATH=/app/master_data.json
# INVENTORY_ENTRIES_PATH=/app/inventory_entries.json

# Optional: enable API key auth for all endpoints except /health
# API_KEY=replace-with-strong-random-key

# Optional: allow only specific web origins (comma separated)
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
